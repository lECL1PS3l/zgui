<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ZapretGui.App</AssemblyName>
    <RootNamespace>ZapretGui.App</RootNamespace>
    <AssemblyTitle>ZapretGui.App</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZapretGui.Core\ZapretGui.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ILRepack" Version="2.0.27" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ресурсы берутся из Tauri-части, чтобы не дублировать мегабайты в репо. -->
    <EmbeddedResource Include="..\..\..\src-tauri\resources\engine-flowseal.zip" Link="assets\engine-flowseal.zip" />
    <EmbeddedResource Include="..\..\..\src-tauri\resources\flowseal-main.zip" Link="assets\flowseal-main.zip" />
    <!-- Telegram-мост: собирается cargo, поэтому optional — без него GUI
         просто сообщает, что мост не найден. -->
    <EmbeddedResource Include="..\..\..\src-tauri\target\release\zgui-bridge.exe" Link="assets\tg-ws-proxy.exe" Condition="Exists('..\..\..\src-tauri\target\release\zgui-bridge.exe')" />
  </ItemGroup>

</Project>
